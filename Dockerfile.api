# ============================================================
#  Panghu Agent — API 服务镜像（依赖+代码，agent.py 通过 ConfigMap 覆盖）
#  用法: docker build -f Dockerfile.api -t agent-api:latest .
# ============================================================
ARG REGISTRY=arm-cluster-master:5000
FROM ${REGISTRY}/agent-api-base:latest

COPY . /app

ENV PYTHONUNBUFFERED=1
EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=10s --retries=3 \
    CMD curl -sf http://localhost:8000/health || exit 1
CMD ["python", "-m", "uvicorn", "app.api.agent:app", "--host", "0.0.0.0", "--port", "8000", "--reload"]
