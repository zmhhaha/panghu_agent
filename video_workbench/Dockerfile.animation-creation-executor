# Build the complete executor from a clean Git checkout at the repository root:
# docker build -f video_workbench/Dockerfile.animation-creation-executor \
#   --build-arg SOURCE_REVISION=<full-git-sha> \
#   -t arm-cluster-master:5000/video-animation-creation:latest .
# Dependencies use ordinary Docker layer caching; no deployed application donor.
ARG PYTHON_BASE_IMAGE=python@sha256:cf50a4f6ac4f026458b08d5222023d700ac806410dff5e9ca8728fa44f2b850f
FROM ${PYTHON_BASE_IMAGE}

USER 0:0
WORKDIR /app
ENV PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1 \
    PIP_DISABLE_PIP_VERSION_CHECK=1 \
    DOCKER_HOST=unix:///var/run/docker.sock \
    DOCKER_CONFIG=/tmp/docker-config

ARG DEBIAN_MIRROR=https://mirrors.tuna.tsinghua.edu.cn/debian
RUN sed -i "s|http://deb.debian.org/debian|${DEBIAN_MIRROR}|g" /etc/apt/sources.list.d/debian.sources \
    && apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates docker.io docker-cli ffmpeg poppler-utils libpango-1.0-0 libpangoft2-1.0-0 fonts-noto-cjk \
    && rm -rf /var/lib/apt/lists/* \
    && docker --version \
    && ffmpeg -version >/dev/null \
    && ffprobe -version >/dev/null

COPY video_workbench/requirements.txt /app/requirements.txt
ARG PYPI_INDEX_URL=https://pypi.tuna.tsinghua.edu.cn/simple
RUN pip install --no-cache-dir --index-url "${PYPI_INDEX_URL}" -r /app/requirements.txt \
    && python -m pip check

# The Dockerfile-specific ignore rules omit runtime state and credentials.
# All application modules and their image-owned resource bundles come from Git.
COPY agent_service/ /app/agent_service/
COPY video_workbench/ /app/video_workbench/
ARG SOURCE_REVISION
RUN python -c "import os,re; assert re.fullmatch(r'[0-9a-f]{40}',os.environ['SOURCE_REVISION'])" \
    && python -c "from agent_service.profiles.video_animation_method import verified_bundle; from video_workbench.animation_method_renderer import MethodAnimationRenderer; verified_bundle()" \
    && python -c "from agent_service.profiles.video_animation_skill_method import verified_bundle; from agent_service.profiles.video_animation_skill_production import verified_bundle as production_bundle; from video_workbench.animation_knowledge import AnimationKnowledgeStore; verified_bundle(); production_bundle()" \
    && python -c "from video_workbench.animation_creation_executor import create_server; from agent_service.profiles.video_animation_create import verified_bundle; from agent_service.profiles.video_animation_review import verified_bundle as old_bundle,verified_sequence_bundle,verified_batch_bundle,verified_packed_bundle; from agent_service.input_tools import verified_read_inputs_extension; verified_bundle(); old_bundle(); verified_sequence_bundle(); verified_batch_bundle(); verified_packed_bundle(); verified_read_inputs_extension()" \
    && mkdir -p /var/lib/video-animation-creation
LABEL org.opencontainers.image.source="https://github.com/zmhhaha/panghu_agent" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.panghu.animation-creation.build="full-source" \
      io.panghu.animation-creation.trust-boundary="root-docker-controller-not-restricted-renderer"
EXPOSE 8767
# The manifest supplies root, fixed Agent origin, distinct token files, pinned
# renderer image and explicit rendering opt-in. Starting without them fails.
CMD ["python", "-m", "video_workbench.animation_creation_executor"]
