# ============================================================
#  Panghu Agent — UI 服务镜像（仅依赖层，源码通过 hostPath 挂载）
#  用法: docker build -f Dockerfile.ui -t agent-ui:latest .
# ============================================================
ARG REGISTRY=arm-cluster-master:5000
FROM ${REGISTRY}/base:latest

RUN apt-get update && apt-get install -y --no-install-recommends \
    python3 python3-pip && \
    rm -rf /var/lib/apt/lists/* && \
    update-alternatives --install /usr/bin/python python /usr/bin/python3 1

WORKDIR /app

# ---- 只安装依赖，不 COPY 源码（源码通过 K8s hostPath 挂载） ----
RUN pip install --break-system-packages --no-cache-dir \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    gradio>=5.0.0 requests>=2.31.0 python-dotenv>=1.0.0

ENV PYTHONUNBUFFERED=1 \
    GRADIO_SERVER_NAME="0.0.0.0" \
    GRADIO_SERVER_PORT="7860"
EXPOSE 7860
CMD ["python", "app/ui/research_agent.py"]
