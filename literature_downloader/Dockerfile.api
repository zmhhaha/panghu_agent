ARG REGISTRY=arm-cluster-master:5000
FROM ${REGISTRY}/agent-api-base:latest

# The shared API base provides FastAPI/Uvicorn and the common agent tooling.
# Literature verification adds only the PDF parser on top of that image.
RUN pip install --break-system-packages --no-cache-dir \
    -i https://mirrors.aliyun.com/pypi/simple/ \
    --trusted-host mirrors.aliyun.com \
    --default-timeout=300 \
    "pypdf>=4.0.0"

COPY . /app

ENV PYTHONUNBUFFERED=1 \
    LITERATURE_DATA_DIR=/data/literature

EXPOSE 8000
HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD curl -fsS http://127.0.0.1:8000/literature-health || exit 1

CMD ["python", "-m", "uvicorn", "app.api.agent:app", "--host", "0.0.0.0", "--port", "8000"]
