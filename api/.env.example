# ============================================================
# API 服务配置
# ============================================================
API_PORT=8000

# 管理员密钥 — 用于 /admin/* 端点，请改为强密码
ADMIN_API_KEY=admin-secret-change-me

# 管理员邮箱（初始化时创建）
ADMIN_EMAIL=admin@localhost

# SQLite 数据库路径（默认在 api/ 目录下）
# DATABASE_URL=sqlite:///data.db
