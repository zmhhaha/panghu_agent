{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "title":"video-explanation-result.v1",
  "type":"object","additionalProperties":false,
  "required":["schema_version","input_sha256","summary","scenes","warnings"],
  "properties":{
    "schema_version":{"const":"video-explanation-result.v1"},
    "input_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
    "summary":{"type":"string","minLength":1,"maxLength":4000},
    "scenes":{"type":"array","minItems":1,"maxItems":24,"items":{"$ref":"#/$defs/scene"}},
    "warnings":{"type":"array","maxItems":16,"items":{"type":"string","minLength":1,"maxLength":1000}}
  },
  "$defs":{
    "scene":{
      "type":"object","additionalProperties":false,
      "required":["scene_id","title","narration","visual_description","duration_seconds","pronunciation","key_points","visual_strategy","visual_steps","delivery_note","source_quotes"],
      "properties":{
        "scene_id":{"type":"string","minLength":1,"maxLength":100},
        "title":{"type":"string","minLength":1,"maxLength":160},
        "narration":{"type":"string","minLength":1,"maxLength":2000},
        "visual_description":{"type":"string","minLength":1,"maxLength":8000},
        "duration_seconds":{"type":"number","minimum":1,"maximum":120},
        "pronunciation":{"type":"object","maxProperties":32,"propertyNames":{"minLength":1,"maxLength":80},"additionalProperties":{"type":"string","minLength":1,"maxLength":200}},
        "key_points":{"type":"array","minItems":1,"maxItems":4,"items":{"type":"string","minLength":1,"maxLength":120}},
        "visual_strategy":{"enum":["flow","compare","focus"]},
        "visual_steps":{"type":"array","minItems":2,"maxItems":6,"items":{"type":"string","minLength":1,"maxLength":240}},
        "delivery_note":{"type":"string","maxLength":400},
        "source_quotes":{"type":"array","minItems":1,"maxItems":6,"items":{"type":"string","minLength":1,"maxLength":2000}}
      }
    }
  }
}
