# Build arguments must name reviewed immutable image digests. The donor provides
# pinned Pi 0.73.1 and its compatible Node binary; no private Agent HOME is copied.
ARG PI_DONOR_IMAGE
ARG PYTHON_BASE_IMAGE
ARG PPT_DONOR_IMAGE
FROM ${PI_DONOR_IMAGE} AS pi_donor
FROM ${PPT_DONOR_IMAGE} AS neutral_runtime
USER 0:0
# Keep the reviewed donor fixed. This dependency stage is identical in both
# Worker Dockerfiles and remains cached when only application sources change.
COPY agent_service/requirements.txt /tmp/agent-service-requirements.txt
RUN /opt/hermes/.venv/bin/python -m venv /opt/agent-service/.venv \
    && /opt/agent-service/.venv/bin/python -m pip install --no-cache-dir -r /tmp/agent-service-requirements.txt \
    && /opt/agent-service/.venv/bin/python -m pip check \
    && rm /tmp/agent-service-requirements.txt \
    && chown -R 0:0 /opt/ppt-master \
    && chmod -R a+rX,go-w /opt/ppt-master
FROM neutral_runtime
RUN if [ "$(dpkg-query -W -f='${Status}\n' ca-certificates libstdc++6 2>/dev/null | grep -cx 'install ok installed')" != 2 ]; then \
      apt-get update && apt-get install -y --no-install-recommends ca-certificates libstdc++6 \
      && rm -rf /var/lib/apt/lists/*; \
    fi
COPY --from=pi_donor /usr/local/bin/node /usr/local/bin/node
COPY --from=pi_donor /opt/pi/ /opt/pi/
COPY agent_service/ /opt/agent-service/agent_service/
COPY agent_service/academic_extension.mjs /opt/pi/node_modules/agent-service-academic.mjs
COPY scientific_agent/ /opt/agent-service/scientific_agent/
COPY pi_worker/ /opt/agent-service/pi_worker/
COPY tools/ /opt/agent-service/tools/
COPY scientific_skills/ /opt/agent-service/scientific_skills/
RUN mkdir -p /run/agent-control /run/agent-secrets /work \
    && chmod 0700 /run/agent-control /run/agent-secrets \
    && chmod 0711 /work \
    && chmod -R a+rX /opt/agent-service
ENV PYTHONPATH=/opt/agent-service PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1 HOME=/run/agent-control
WORKDIR /opt/agent-service
EXPOSE 8090
# Python must be PID 1 in a private Pod PID namespace. The trusted controller
# needs CHOWN, DAC_OVERRIDE, KILL, SETUID, SETGID only; the child launcher clears
# all capabilities and sets no_new_privs. No model credential is baked in.
ENTRYPOINT ["/opt/agent-service/.venv/bin/python", "-m", "agent_service.worker_entry"]
CMD []
