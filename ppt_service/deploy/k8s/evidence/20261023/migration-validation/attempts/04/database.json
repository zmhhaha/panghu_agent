    {
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.ppt_immutable_job_input()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$ BEGIN IF NEW.input_snapshot::jsonb IS DISTINCT FROM OLD.input_snapshot::jsonb THEN RAISE EXCEPTION 'immutable job input'; END IF; RETURN NEW; END $function$\n",
      "proname": "ppt_immutable_job_input"
    },
    {
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.ppt_immutable_plan()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$ BEGIN IF (to_jsonb(NEW)-'confirmed_at'-'confirmation_selection') IS DISTINCT FROM (to_jsonb(OLD)-'confirmed_at'-'confirmation_selection') OR (OLD.confirmed_at IS NOT NULL AND NEW.confirmation_selection::jsonb IS DISTINCT FROM OLD.confirmation_selection::jsonb) THEN RAISE EXCEPTION 'immutable plan'; END IF; RETURN NEW; END $function$\n",
      "proname": "ppt_immutable_plan"
    },
    {
      "arguments": "",
      "definition": "CREATE OR REPLACE FUNCTION public.ppt_immutable_record()\n RETURNS trigger\n LANGUAGE plpgsql\nAS $function$ BEGIN RAISE EXCEPTION 'immutable record'; END $function$\n",
      "proname": "ppt_immutable_record"
    }
