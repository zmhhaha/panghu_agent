# ============================================================
# 模型调用：统一走集群内 llm-service
# 本工程不再持有任何 provider 凭据，本地跑同样只配这三个变量。
# 部署到 K8s 时由 k8s/api-deployment.yaml 注入，不需要这个文件。
# ============================================================
LLM_BASE_URL=http://llm-service.llm.svc.cluster.local/v1
LLM_MODEL=chat-guarded
LLM_SERVICE_TOKEN=

# ---- 模型别名（按 Agent 选，见 llm-service/README.md 的档位策略）----
#   chat-guarded  guarded 档，给「用户会写 prompt」的对话型 Agent
#                 （禁 tools / response_format，收紧 max_tokens）
#   chat-tools    trusted 档，给带检索工具的 Agent
#                 （research_agent / scientific_agent / game_review_agent）
#   chat-default  trusted 档，纯文本生成
#                 （RAG、literature_downloader）
# 选错档位的典型症状：guarded 档带 tools → llm-service 返回 400。

# ============================================================
# 学术检索（均可选；留空仍可使用匿名额度）
# ============================================================
# ACADEMIC_CONTACT_EMAIL=researcher@example.com
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=

# ============================================================
# Agent 工具安全边界
# 文件工具只能访问 AGENT_FILE_ROOT；网页正文最大读取 5 MiB。
# ============================================================
# AGENT_FILE_ROOT=/app/data
# WEB_FETCH_MAX_BYTES=5242880
