# 模型提供商：anthropic / openai / deepseek / custom
PROVIDER=openai

# ============================================================
# 方式一：使用预设提供商（PROVIDER 为 openai / anthropic / deepseek）
# 只需填写对应 API Key 即可
# ============================================================
OPENAI_API_KEY=sk-your-openai-key-here
# ANTHROPIC_API_KEY=sk-ant-your-key-here

# ============================================================
# 方式二：自定义 API（PROVIDER=custom）
# 可接入任何兼容 OpenAI API 的端点（如本地 ollama、vLLM、国产大模型等）
# ============================================================
# CUSTOM_API_BASE=http://localhost:11434/v1
# CUSTOM_API_KEY=your-api-key-here
# CUSTOM_MODEL=gpt-4o-mini
