# 模型提供商：anthropic / openai / deepseek / custom
PROVIDER=openai

# ============================================================
# 各 provider 使用独立前缀的环境变量（与 panghu_game 约定一致）。
# 凭据在生产环境通过 Vault Secret 注入，ConfigMap 只放 PROVIDER。
# ============================================================

# ---- OpenAI ----
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_API_KEY=sk-your-openai-key-here
# OPENAI_MODEL=gpt-4o-mini

# ---- DeepSeek（OpenAI 兼容格式）----
# DEEPSEEK_BASE_URL=https://api.deepseek.com
# DEEPSEEK_API_KEY=sk-your-deepseek-key-here
# DEEPSEEK_MODEL=deepseek-v4-flash

# ---- Anthropic ----
# ANTHROPIC_BASE_URL=https://api.anthropic.com
# ANTHROPIC_API_KEY=sk-ant-your-key-here
# ANTHROPIC_MODEL=claude-sonnet-4-6-20250514

# ---- 自定义 API（任何 OpenAI 兼容端点，如本地 ollama、vLLM）----
# CUSTOM_BASE_URL=http://localhost:11434/v1
# CUSTOM_API_KEY=your-api-key-here
# CUSTOM_MODEL=gpt-4o-mini

# ============================================================
# 学术检索（均可选；留空仍可使用匿名额度）
# ============================================================
# ACADEMIC_CONTACT_EMAIL=researcher@example.com
# SEMANTIC_SCHOLAR_API_KEY=
# NCBI_API_KEY=

# ============================================================
# Agent 工具安全边界
# 文件工具只能访问 AGENT_FILE_ROOT；网页正文最大读取 5 MiB。
# ============================================================
# AGENT_FILE_ROOT=/app/data
# WEB_FETCH_MAX_BYTES=5242880
